						{
							"_type": "UMLNoteView",
							"_id": "e40b4a50bfdc4a38b2b3a77495c0ed6d",
							"_parent": {
								"$ref": "d67be955ec8c44dfb09ad991d22664c0"
							},
							"lineColor": "#777777",
							"fillColor": "#FFFBE9",
							"font": "Arial;16;0",
							"left": 3440,
							"top": 160,
							"width": 600,
							"height": 155,
							"text": "HealthFlow | CASO 1\nUniversidad Tecnológica de El Salvador\nLenguaje unificado de modelado UML\nAutor: José Fernando Díaz del Cid"
						},
						{
							"_type": "UMLNoteView",
							"_id": "24bee0f6c7bd45dcaddb658537f1c6c7",
							"_parent": {
								"$ref": "d67be955ec8c44dfb09ad991d22664c0"
							},
							"lineColor": "#777777",
							"fillColor": "#FFFBE9",
							"font": "Arial;16;0",
							"left": 3440,
							"top": 390,
							"width": 600,
							"height": 190,
							"text": "CONVENCIONES\n- atributo privado / + operación pública\nEmpleado y describirRol() son abstractos.\nRombo negro: composición; blanco: agregación.\nMultiplicidad junto a un extremo = objetos de ese extremo."
						},
						{
							"_type": "UMLNoteView",
							"_id": "eaf2fb96164e435aaa76c8c13bb83b12",
							"_parent": {
								"$ref": "d67be955ec8c44dfb09ad991d22664c0"
							},
							"lineColor": "#777777",
							"fillColor": "#FFFBE9",
							"font": "Arial;16;0",
							"left": 60,
							"top": 1230,
							"width": 1340,
							"height": 255,
							"text": "RESTRICCIONES CLÍNICAS\nPaciente y expediente se crean juntos y permanecen vinculados.\n0..* permite un expediente recién abierto sin consultas ni recetas.\nNo se elimina historia por alta o fallecimiento del paciente.\nConsulta y receta se archivan como documentos exclusivos.\nLos parámetros de operaciones no implican propiedad UML."
						},
						{
							"_type": "UMLNoteView",
							"_id": "ee2857c5c65243c48c331b4b0a6f398d",
							"_parent": {
								"$ref": "d67be955ec8c44dfb09ad991d22664c0"
							},
							"lineColor": "#777777",
							"fillColor": "#FFFBE9",
							"font": "Arial;16;0",
							"left": 1640,
							"top": 2230,
							"width": 2400,
							"height": 200,
							"text": "RESTRICCIONES QUIRÚRGICAS\nfin > inicio; no solapar sala, paciente ni médicos.\nIntervención finalizada: al menos un consumo.\ncantidad > 0; stock >= cantidad; stock final >= 0.\nUn equipo ocupa como máximo una sala a la vez.\nLa baja de entidades conserva el historial clínico."
						}
					]
				},
				{
					"_type": "UMLClass",
